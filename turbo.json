{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "TAVILY_API_KEY",
        "BHASHINI_INFERENCE_KEY",
        "OLLAMA_URL",
        "NEXT_PUBLIC_OLLAMA_TEST_URL"
      ]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "env": [
        "TAVILY_API_KEY",
        "BHASHINI_INFERENCE_KEY",
        "OLLAMA_URL"
      ]
    }
  }
}
