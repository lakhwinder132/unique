OLLAMA_URL=http://localhost:11434

# Optional. Mount the existing PAU RAG project at this path in the runtime.
# Its Python dependencies and pinned model cache must also be present there.
RAG_DATA_ROOT=D:\Users\Course_Code\data\punjabi-farmer-data
# Override for Linux deployments; the project's Windows virtual environment
# cannot run in a Linux container.
RAG_PYTHON_PATH=
# Optional override when the retriever scripts are mounted separately.
RAG_SCRIPT_DIR=
RAG_TOP_K=5

# Optional, consent-based app activity records. Generate a private token with:
# openssl rand -hex 32
ACTIVITY_ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters
ACTIVITY_LOG_DIR=/var/lib/ollama-farmer/activity
